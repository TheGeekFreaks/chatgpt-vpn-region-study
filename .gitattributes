*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
# Matplotlib emits trailing coordinate separators inside multiline SVG paths.
extensions/v3-codex-route-language/derived/*.svg text eol=lf whitespace=-blank-at-eol
*.pdf binary
*.png binary

# Preserve exact bytes for inputs bound by SHA-256 in the study provenance.
*.csv -text whitespace=cr-at-eol
protocol/schedule.json -text whitespace=cr-at-eol
protocol/prompts/*.txt -text whitespace=cr-at-eol
extensions/**/protocol/*.txt -text whitespace=cr-at-eol
extensions/**/protocol/schedule.json -text whitespace=cr-at-eol
