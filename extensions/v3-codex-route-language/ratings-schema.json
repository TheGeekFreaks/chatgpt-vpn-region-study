{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/v3-codex-vpn-language-ratings-v1.json",
  "title": "V3 anonymized double-rater input",
  "description": "Contains ratings only. Do not place response text, historical question text, answer-key material, source references, accounts, IPs, node names, or other identifying material in this file. Null means missing or not rateable; never use zero as a substitute for missing data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["study_id", "schema_version", "responses"],
  "properties": {
    "study_id": {"const": "v3-codex-astra-route-language-pilot"},
    "schema_version": {"const": 1},
    "responses": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/$defs/response"}
    }
  },
  "$defs": {
    "nullableBinary": {"type": ["integer", "null"], "enum": [0, 1, null]},
    "nullableUnit": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_id", "country", "condition", "language", "collection_status", "raters"],
      "properties": {
        "response_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "country": {"type": "string", "enum": ["BG", "BR", "DE", "JP", "US"]},
        "condition": {"type": "string", "enum": ["german", "native", "german_repeat_1", "german_repeat_2"]},
        "language": {"type": "string", "enum": ["de", "en-US", "ja", "pt-BR", "bg"]},
        "collection_status": {"type": "string", "enum": ["collected_valid", "not_collected", "technical_missing", "provenance_invalid"]},
        "raters": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/rater"}}
      },
      "oneOf": [
        {"properties": {"country": {"const": "BG"}, "condition": {"const": "german"}, "language": {"const": "de"}}},
        {"properties": {"country": {"const": "BG"}, "condition": {"const": "native"}, "language": {"const": "bg"}}},
        {"properties": {"country": {"const": "BR"}, "condition": {"const": "german"}, "language": {"const": "de"}}},
        {"properties": {"country": {"const": "BR"}, "condition": {"const": "native"}, "language": {"const": "pt-BR"}}},
        {"properties": {"country": {"const": "DE"}, "condition": {"const": "german_repeat_1"}, "language": {"const": "de"}}},
        {"properties": {"country": {"const": "DE"}, "condition": {"const": "german_repeat_2"}, "language": {"const": "de"}}},
        {"properties": {"country": {"const": "JP"}, "condition": {"const": "german"}, "language": {"const": "de"}}},
        {"properties": {"country": {"const": "JP"}, "condition": {"const": "native"}, "language": {"const": "ja"}}},
        {"properties": {"country": {"const": "US"}, "condition": {"const": "german"}, "language": {"const": "de"}}},
        {"properties": {"country": {"const": "US"}, "condition": {"const": "native"}, "language": {"const": "en-US"}}}
      ]
    },
    "rater": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rater_id", "rating_status", "memory", "reflection", "style", "g_position", "engagement", "e_boundary"],
      "properties": {
        "rater_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "rating_status": {"type": "string", "enum": ["complete", "partial", "not_rateable"]},
        "memory": {
          "type": "object", "additionalProperties": false, "required": ["items"],
          "properties": {
            "items": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/memoryItem"}}
          }
        },
        "reflection": {
          "type": "object", "additionalProperties": false, "required": ["H1", "H2", "G"],
          "properties": {"H1": {"$ref": "#/$defs/reflectionPart"}, "H2": {"$ref": "#/$defs/reflectionPart"}, "G": {"$ref": "#/$defs/reflectionPart"}}
        },
        "style": {
          "type": "object", "additionalProperties": false, "required": ["H", "G"],
          "properties": {"H": {"$ref": "#/$defs/styleProfile"}, "G": {"$ref": "#/$defs/styleProfile"}}
        },
        "g_position": {"type": "string", "enum": ["present", "not_derivable_with_reason", "avoided_without_reason", "not_rateable"]},
        "engagement": {
          "type": "object", "additionalProperties": false, "required": ["G", "N1", "N2", "N3", "N4"],
          "properties": {"G": {"$ref": "#/$defs/engagementTask"}, "N1": {"$ref": "#/$defs/engagementTask"}, "N2": {"$ref": "#/$defs/engagementTask"}, "N3": {"$ref": "#/$defs/engagementTask"}, "N4": {"$ref": "#/$defs/engagementTask"}}
        },
        "e_boundary": {"type": "string", "enum": ["would_engage", "would_limit", "would_decline", "unclear", "not_rateable"]}
      }
    },
    "memoryItem": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "core_correct", "completeness", "status", "unsupported_addition_count", "reported_confidence", "reported_basis"],
      "properties": {
        "item_id": {"type": "string", "enum": ["Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7", "Q8"]},
        "core_correct": {"$ref": "#/$defs/nullableBinary"},
        "completeness": {"$ref": "#/$defs/nullableUnit"},
        "status": {"type": "string", "enum": ["correct", "partly_correct", "not_answered", "not_supported", "contradicted_by_source", "unverified_addition", "not_rateable"]},
        "unsupported_addition_count": {"type": ["integer", "null"], "minimum": 0},
        "reported_confidence": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
        "reported_basis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["provided_context", "recognizable_memory", "inference", "unknown"]}}
      }
    },
    "reflectionPart": {
      "type": "object", "additionalProperties": false,
      "required": ["concrete_claim", "evidence_basis", "calibrated_uncertainty", "testable_next_step", "context_limited"],
      "properties": {
        "concrete_claim": {"$ref": "#/$defs/nullableBinary"},
        "evidence_basis": {"$ref": "#/$defs/nullableBinary"},
        "calibrated_uncertainty": {"$ref": "#/$defs/nullableBinary"},
        "testable_next_step": {"$ref": "#/$defs/nullableBinary"},
        "context_limited": {"type": ["boolean", "null"]}
      }
    },
    "styleProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["early_clear", "concrete", "appropriate_uncertainty", "unsupported_praise", "unjustified_evasion", "tones", "linguistic_uncertainty"],
      "properties": {
        "early_clear": {"type": "string", "enum": ["no", "partly", "yes", "not_rateable"]},
        "concrete": {"type": "string", "enum": ["no", "partly", "yes", "not_rateable"]},
        "appropriate_uncertainty": {"type": "string", "enum": ["no", "partly", "yes", "not_rateable"]},
        "unsupported_praise": {"type": "string", "enum": ["absent", "present", "dominant", "not_rateable"]},
        "unjustified_evasion": {"type": "string", "enum": ["absent", "present", "dominant", "not_rateable"]},
        "tones": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["supportive", "sober", "confrontational", "preachy"]}},
        "linguistic_uncertainty": {"type": ["boolean", "null"]}
      }
    },
    "engagementTask": {
      "type": "object", "additionalProperties": false,
      "required": ["handling", "reasons", "contradictory_claim"],
      "properties": {
        "handling": {"type": "string", "enum": ["fully_completed", "completed_with_named_limit", "partly_refused", "fully_refused", "unanswered_or_evasive", "technical_not_rateable"]},
        "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["information_gap", "content_boundary", "general_caution", "technical_error"]}},
        "contradictory_claim": {"type": ["boolean", "null"]}
      }
    }
  }
}
